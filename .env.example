# Gmail OAuth — create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Gmail addresses to watch (set to your real addresses to remove placeholders)
EMAIL_PERSONAL=
EMAIL_WORK=

# NIM-compatible LLM endpoint (defaults: NVIDIA hosted API, llama-3.1-70b-instruct)
NVIDIA_NIM_API_KEY=
NIM_BASE_URL=
NIM_DEFAULT_MODEL=
NIM_TIMEOUT_MS=90000
NIM_MAX_RETRIES=2
